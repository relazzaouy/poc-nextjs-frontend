# Base URL of the NestJS backend. No trailing slash.
# The app calls ${NEXT_PUBLIC_API_URL}/api/hello
#
# Local development (backend runs on 3001):
NEXT_PUBLIC_API_URL=http://localhost:3001
#
# On Render set this to the deployed backend URL, e.g.
#   NEXT_PUBLIC_API_URL=https://poc-nestjs-backend.onrender.com
